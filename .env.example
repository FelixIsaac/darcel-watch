# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=sk-or-v1-...      # Gemini 2.5 Flash via OpenRouter
SPECTRUM_PROJECT_ID=                 # Photon/Spectrum, optional (iMessage)
SPECTRUM_PROJECT_SECRET=
REVIEWER_PHONE=+1...                 # must be registered as a Photon project user
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# TypeSafe Jev - typed, calibrated judgments (https://docs.typesafe.ai)
# Without it, audit.py abstains rather than guessing.
JEV_API_KEY=
